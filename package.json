{
	"name": "volar",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "npm run validate && vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && tsc -p src/service-worker --noEmit",
		"validate": "tsx scripts/validate-content.ts",
		"test": "vitest run",
		"e2e": "playwright test",
		"bake:globe": "tsx scripts/bake-globe.ts",
		"build:audio": "tsx scripts/build-audio.ts",
		"make:icons": "tsx scripts/make-icons.ts"
	},
	"imports": {
		"#lib/*": "./src/lib/*"
	},
	"dependencies": {
		"@fontsource/andika": "^5.3.0",
		"@threlte/core": "^8.6.1",
		"@threlte/extras": "^9.22.3",
		"dexie": "^4.4.7",
		"gsap": "^3.15.0",
		"howler": "^2.2.4",
		"three": "^0.186.1",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@playwright/test": "^1.64.1",
		"@sveltejs/adapter-static": "^4.0.0",
		"@sveltejs/kit": "^3.1.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@types/howler": "^2.2.13",
		"@types/node": "^24.19.2",
		"@types/three": "^0.186.0",
		"fake-indexeddb": "^6.2.6",
		"ffmpeg-static": "^5.3.0",
		"sharp": "^0.35.5",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.7",
		"tsx": "^4.23.15",
		"typescript": "^6.0.3",
		"vite": "^8.3.5",
		"vitest": "^5.0.5"
	}
}
